local magnetConn, magnetFrame = nil, 0
local coinOriginal = {}
local function prepararCoin(part)
    if not part:IsA("BasePart") then return end
    if coinOriginal[part] == nil then
        coinOriginal[part] = { cf = part.CFrame, anc = part.Anchored, col = part.CanCollide }
    end
    part.Anchored = true
    part.CanCollide = false
end
local function restaurarCoins()
    for part, o in pairs(coinOriginal) do
        if part and part.Parent then
            pcall(function()
                part.CFrame = o.cf
                part.Anchored = o.anc
                part.CanCollide = o.col
            end)
        end
    end
    table.clear(coinOriginal)
end
local function ligarMagnet()
    if magnetConn then return end
    magnetConn = RunService.Heartbeat:Connect(function()
        if not CFG.magnetOn then return end
        local pos, de = posAlvoMagnet()
        if not pos then F.magnetInfo = "sem carro/personagem" return end
        local pasta = getPastaCoins()
        if not pasta then F.magnetInfo = "CoinsFolder nao encontrada" return end

        magnetFrame += 1
        local off = (magnetFrame % 2 == 0) and CFG.magnetJitter or -CFG.magnetJitter
        local destino = CFrame.new(pos + Vector3.new(0, CFG.magnetAltura + off, 0))
        local n = 0
        for _, coin in ipairs(pasta:GetChildren()) do
            local ok = true
            if CFG.magnetRaio > 0 then
                local cp = posDoCoin(coin)
                ok = cp and (cp - pos).Magnitude <= CFG.magnetRaio
            end
            if ok then
                if coin:IsA("BasePart") then
                    prepararCoin(coin)
                    coin.CFrame = destino
                    n += 1
                elseif coin:IsA("Model") then
                    pcall(function()
                        for _, p in ipairs(coin:GetDescendants()) do
                            if p:IsA("BasePart") then prepararCoin(p) end
                        end
                        coin:PivotTo(destino)
                    end)
                    n += 1
                end
            end
        end
        F.magnetInfo = ("puxando %d coin(s) pro %s"):format(n, de)
    end)
end
local function desligarMagnet()
    if magnetConn then magnetConn:Disconnect() magnetConn = nil end
    restaurarCoins()
    F.magnetInfo = "parado"
end
task.spawn(function()
    while true do
        task.wait(5)
        for part in pairs(coinOriginal) do
            if not part.Parent then coinOriginal[part] = nil end
        end
    end
end)

