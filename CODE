E.ligado = false
E.ultimo, E.fps, E.quadros, E.fpsHora, E.medido = 0, 60, 0, tick(), false

local function corDoAlvo(d)
    local m = CFG.espModoCor
    if m == 1 then
        return Color3.fromHSV(((tick() * CFG.espArcoVel * 0.1) + d.deslocamento) % 1, 1, 1)
    elseif m == 2 then
        local v = d.vidaFrac or 1
        if v > 0.6 then return Color3.fromRGB(60, 220, 90) end
        if v > 0.3 then return Color3.fromRGB(240, 210, 60) end
        return Color3.fromRGB(235, 60, 60)
    elseif m == 3 then
        if d.dist < CFG.espPerto then return Color3.fromRGB(235, 70, 70) end
        if d.dist < CFG.espMedio then return Color3.fromRGB(240, 190, 60) end
        return Color3.fromRGB(90, 190, 255)
    elseif m == 4 then
        return d.mesmoTime and Color3.fromRGB(80, 180, 255) or Color3.fromRGB(235, 70, 70)
    elseif m == 5 then
        if d.visivel then return Color3.fromRGB(CFG.espVisR, CFG.espVisG, CFG.espVisB) end
        return Color3.fromRGB(CFG.espOcuR, CFG.espOcuG, CFG.espOcuB)
    end
    return Color3.fromRGB(CFG.espCorR, CFG.espCorG, CFG.espCorB)
end
local function pulso()
    if not CFG.espPulso then return 0 end
    return 0.35 * math.abs(math.sin(tick() * CFG.espPulsoVel))
end
local function ehAmigo(p)
    local ok, r = pcall(function() return LP:IsFriendsWith(p.UserId) end)
    return ok and r or false
end
local timesCache, timesCacheEm = false, 0
local function jogoTemTimes()
    if tick() - timesCacheEm > 3 then
        timesCacheEm = tick()
        local ok, lista = pcall(function() return Teams:GetTeams() end)
        timesCache = (ok and lista and #lista > 0) or false
    end
    return timesCache
end
local function mesmoTime(p)
    if p == LP then return true end
    local modo = CFG.TeamCheckModo or 0
    if modo == 3 then return false end
    local meu, dele = LP.Team, p.Team
    if modo ~= 2 then
        if meu and dele then return meu == dele end
        if meu or dele then return false end
        if modo == 1 then return false end
    end
    if modo ~= 2 and not jogoTemTimes() then return false end
    local okN, neutro = pcall(function() return LP.Neutral or p.Neutral end)
    if okN and neutro then return false end
    local ok, igual = pcall(function() return LP.TeamColor == p.TeamColor end)
    return (ok and igual) or false
end
local function podeMostrar(p, h, dist)
    if p == LP then return false end
    if CFG.espDistMax > 0 and dist > CFG.espDistMax then return false end
    if CFG.espIgnorarAmigo and ehAmigo(p) then return false end
    local escondeTime = (CFG.espTimeModo == 1) or (CFG.espTimeModo == 2 and CFG.TeamCheck)
    if escondeTime and mesmoTime(p) then return false end
    if CFG.espIgnorarMorto and (not h or h.Health <= 0) then return false end
    if CFG.espIgnorarSentado and h and h.Sit then return false end
    if CFG.espSoMovendo and h and h.MoveDirection.Magnitude < 0.1 then return false end
    if CFG.espIgnorarInvisivel then
        local cab = p.Character and p.Character:FindFirstChild("Head")
        if cab and cab.Transparency >= 0.95 then return false end
    end
    return true
end
local function estaVisivel(pos, personagem)
    local par = RaycastParams.new()
    local ok = pcall(function() par.FilterType = Enum.RaycastFilterType.Exclude end)
    if not ok then pcall(function() par.FilterType = Enum.RaycastFilterType.Blacklist end) end
    par.FilterDescendantsInstances = { myChar(), personagem }
    local de = Camera.CFrame.Position
    return workspace:Raycast(de, pos - de, par) == nil
end
local function alturaDoCorpo(c)
    local cab = c:FindFirstChild("Head")
    local pe  = c:FindFirstChild("LeftFoot") or c:FindFirstChild("Left Leg")
                or c:FindFirstChild("HumanoidRootPart")
    if cab and pe then return math.max((cab.Position - pe.Position).Magnitude + 2, 4) end
    return 6
end
