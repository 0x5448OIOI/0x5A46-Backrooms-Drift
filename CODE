local loggingIn = false
local function doLogin()
    if loggingIn then return end
    local key = string.gsub(keyBox.Text, "%s+", "")
    if key == "" then
        statusLbl.TextColor3 = Theme.Bad
        statusLbl.Text = "Digite uma chave"
        return
    end
    loggingIn = true
    statusLbl.TextColor3 = Theme.SubText
    statusLbl.Text = "Validando..."
    enterBtn.Text = "VALIDANDO..."
    tween(enterBtn, { BackgroundColor3 = Theme.Dim }, SMOOTH)
    local result = PUSL.validate(key)
    if result and result.success then
        AccessGranted = true
        statusLbl.TextColor3 = Theme.Good
        statusLbl.Text = "Acesso concedido"
        enterBtn.Text = "CARREGANDO..."
        tween(enterBtn, { BackgroundColor3 = Theme.Good }, SMOOTH)
        task.delay(0.55, function()
            tween(blur, { Size = 0 }, SMOOTH)
            tween(lf, { BackgroundTransparency = 1 }, SMOOTH)
            task.wait(0.35)
            pcall(function() blur:Destroy() end)
            pcall(function() loginGui:Destroy() end)
