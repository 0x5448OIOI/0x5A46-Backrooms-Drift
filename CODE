end
local function apagar(d)
    for _, k in ipairs({ "brilho","caixaGui","placa","vidaGui","cabecaGui" }) do
        if d[k] then pcall(function() d[k]:Destroy() end) end
    end
    for _, l in ipairs(d.tracers or {}) do pcall(function() l:Destroy() end) end
    for _, o in ipairs(d.ossos3d or {}) do pcall(function() o:Destroy() end) end
end
local function esconder(d)
    for _, k in ipairs({ "brilho","caixaGui","placa","vidaGui","cabecaGui" }) do
        if d[k] then pcall(function() d[k].Enabled = false end) end
    end
    for _, l in ipairs(d.tracers or {}) do l.Visible = false end
    esconder3D(d)
    d.linhas = nil
end
function E.limpar()
    for p, d in pairs(E.alvos) do apagar(d) E.alvos[p] = nil end
end
local function origemTracer(modo, vp)
    if modo == 1 then return Vector2.new(vp.X * 0.5, vp.Y * 0.5) end
    if modo == 2 then return Vector2.new(vp.X * 0.5, 0) end
    if modo == 3 then return pontoDeMira() end
    if modo == 4 then
        local c = myChar()
        local h = c and c:FindFirstChild("Head")
        local p = h and projetar(h.Position, vp)
        return p or Vector2.new(vp.X * 0.5, vp.Y * 0.62)
    end
    return Vector2.new(vp.X * 0.5, vp.Y)
end
local function destinoTracer(c, raizAlvo)
    if CFG.espTracerAte == 1 then
        local h = c and c:FindFirstChild("Head")
        if h then return h.Position end
    elseif CFG.espTracerAte == 2 then
        local pe = c and (c:FindFirstChild("LeftFoot") or c:FindFirstChild("Left Leg"))
        if pe then return pe.Position end
        return raizAlvo.Position - Vector3.new(0, 3, 0)
    end
    return raizAlvo.Position
end
local function pintarAlvo(p, d, dados)
    local c    = p.Character
    local cor1 = corDoAlvo(dados)
    local op   = clamp(CFG.espTransparencia + pulso(), 0, 1)
    local alt  = dados.altura
    if CFG.espBrilho then
        d.brilho.Adornee = c
        d.brilho.FillColor = cor1
        d.brilho.OutlineColor = CFG.espBrilhoContorno and Color3.new(1,1,1) or cor1
        d.brilho.FillTransparency = CFG.espBrilhoTransp
        d.brilho.OutlineTransparency = 0.08
        d.brilho.DepthMode = CFG.espAtravessaParede and Enum.HighlightDepthMode.AlwaysOnTop
                             or Enum.HighlightDepthMode.Occluded
        d.brilho.Enabled = true
    else
        d.brilho.Enabled = false
    end
    if CFG.espCaixa then
        d.caixaGui.Enabled = true
        d.caixaGui.Size = UDim2.new(alt * 0.62, 0, alt, 0)
        local esp = CFG.espEspessura
        if CFG.espEstiloCaixa == 0 then
            for _, b in ipairs(d.cantos) do b.Visible = false end
            local lados = {
                { UDim2.new(1,0,0,esp), UDim2.new(0,0,0,0) },
                { UDim2.new(1,0,0,esp), UDim2.new(0,0,1,-esp) },
                { UDim2.new(0,esp,1,0), UDim2.new(0,0,0,0) },
                { UDim2.new(0,esp,1,0), UDim2.new(1,-esp,0,0) },
            }
            for i, b in ipairs(d.barras) do
                b.Visible = true
                b.Size = lados[i][1]
                b.Position = lados[i][2]
                b.BackgroundColor3 = cor1
                b.BackgroundTransparency = 1 - op
            end
        else
            for _, b in ipairs(d.barras) do b.Visible = false end
            local t = clamp(CFG.espCantoTam, 0.05, 0.5)
            local defs = {
                { UDim2.new(t,0,0,esp), UDim2.new(0,0,0,0),    Vector2.new(0,0) },
                { UDim2.new(0,esp,t,0), UDim2.new(0,0,0,0),    Vector2.new(0,0) },
                { UDim2.new(t,0,0,esp), UDim2.new(1,0,0,0),    Vector2.new(1,0) },
                { UDim2.new(0,esp,t,0), UDim2.new(1,-esp,0,0), Vector2.new(0,0) },
                { UDim2.new(t,0,0,esp), UDim2.new(0,0,1,-esp), Vector2.new(0,0) },
                { UDim2.new(0,esp,t,0), UDim2.new(0,0,1,0),    Vector2.new(0,1) },
                { UDim2.new(t,0,0,esp), UDim2.new(1,0,1,-esp), Vector2.new(1,0) },
                { UDim2.new(0,esp,t,0), UDim2.new(1,-esp,1,0), Vector2.new(0,1) },
            }
            for i, b in ipairs(d.cantos) do
                b.Visible = true
                b.Size = defs[i][1]
                b.Position = defs[i][2]
                b.AnchorPoint = defs[i][3]
                b.BackgroundColor3 = cor1
                b.BackgroundTransparency = 1 - op
            end
        end
        d.preenche.Visible = CFG.espPreencher
        d.preenche.BackgroundColor3 = cor1
        d.preenche.BackgroundTransparency = CFG.espPreencheTransp
    else
        d.caixaGui.Enabled = false
    end
    local temTexto = CFG.espNome or CFG.espDistancia or CFG.espVidaTexto or CFG.espVidaPorcento
    if temTexto then
        d.placa.Enabled = true
        d.placa.StudsOffset = Vector3.new(0, alt * 0.55 + 0.7, 0)
        if CFG.espNome then
            local nome = dados.nome
            if CFG.espTime then
                local t = p.Team and p.Team.Name
                local okC, corNome = pcall(function() return p.TeamColor.Name end)
                if not t and jogoTemTimes() and okC then t = corNome end
                if t then nome = nome .. "  [" .. t .. "]" end
            end
            d.txtNome.Text = nome
            d.txtNome.TextColor3 = cor1
            d.txtNome.TextSize = CFG.espFonte
            d.txtNome.Visible = true
        else
            d.txtNome.Visible = false
        end
        local baixo = {}
        if CFG.espDistancia    then baixo[#baixo+1] = math.floor(dados.dist) .. "m" end
        if CFG.espVidaTexto    then baixo[#baixo+1] = math.floor(dados.vida) .. " hp" end
        if CFG.espVidaPorcento then baixo[#baixo+1] = math.floor(dados.vidaFrac * 100) .. "%" end
        if #baixo > 0 then
            d.txtInfo.Text = table.concat(baixo, "  ·  ")
            d.txtInfo.TextColor3 = cor1
            d.txtInfo.TextSize = math.max(CFG.espFonte - 2, 8)
            d.txtInfo.Visible = true
        else
            d.txtInfo.Visible = false
        end
    else
        d.placa.Enabled = false
    end
    if CFG.espBarraVida then
        d.vidaGui.Enabled = true
        d.vidaGui.Size = UDim2.new(0, 6, alt, 0)
        local lado = (CFG.espBarraLado == 0) and -1 or 1
        d.vidaGui.StudsOffset = Vector3.new(lado * (alt * 0.36), 0, 0)
        d.vidaBarra.Size = UDim2.new(1, 0, clamp(dados.vidaFrac, 0, 1), 0)
        d.vidaBarra.BackgroundColor3 = Color3.fromRGB(60,220,90):Lerp(Color3.fromRGB(235,60,60), 1 - dados.vidaFrac)
    else
        d.vidaGui.Enabled = false
    end
    if CFG.espCabecaAro then
        local cab = c and c:FindFirstChild("Head")
        if cab then
            d.cabecaGui.Adornee = cab
            d.cabecaGui.Enabled = true
            d.cabecaBorda.Color = cor1
            d.cabecaBorda.Thickness = CFG.espEspessura
        else
            d.cabecaGui.Enabled = false
        end
    else
        d.cabecaGui.Enabled = false
    end
    if CFG.espEsqueleto and c then
        if d.corpo3d ~= c then pcall(montar3D, d, c) end
        local w = math.max(CFG.espEsqueleto3DEsp, 1) * 0.02
        local seqC = ColorSequence.new(cor1)
        local seqT = NumberSequence.new(clamp(1 - op, 0, 1))
        for _, bm in ipairs(d.beams3d) do
            bm.Color = seqC bm.Width0 = w bm.Width1 = w
            bm.Transparency = seqT
            bm.LightEmission = CFG.espLinhaBrilho and 0.6 or 0
            bm.Enabled = true
        end
    else
        esconder3D(d)
    end
    d.linhas = {
        tracer = CFG.espTracer,
        cor    = CFG.espLinhaBrilho and cor1:Lerp(Color3.new(1,1,1), 0.35) or cor1,
        grosso = math.max(math.floor(CFG.espLinhaEsp + 0.5), 1),
        transp = clamp(1 - op * CFG.espLinhaOp, 0, 1),
        corpo  = c, raiz = dados.raiz, altura = alt,
    }
end

RunService.RenderStepped:Connect(function()
    if not (AccessGranted and CFG.esp) then return end
    local vp = Camera.ViewportSize
    for _, d in pairs(E.alvos) do
        local L = d.linhas
        if not L or not (L.raiz and L.raiz.Parent) then
            for _, l in ipairs(d.tracers or {}) do l.Visible = false end
        elseif L.tracer then
            garantirTracers(d)
            local fim = projetar(destinoTracer(L.corpo, L.raiz), vp)
            if fim then
                d.tracers[1].Visible = setLine(d.tracers[1],
                    origemTracer(CFG.espTracerDe, vp), fim, L.grosso, L.cor, L.transp)
                if CFG.espTracerDe == 5 then
                    d.tracers[2].Visible = setLine(d.tracers[2],
                        origemTracer(2, vp), fim, L.grosso, L.cor, L.transp)
                else
                    d.tracers[2].Visible = false
                end
            else
                for _, l in ipairs(d.tracers) do l.Visible = false end
            end
        else
            for _, l in ipairs(d.tracers or {}) do l.Visible = false end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    E.quadros = E.quadros + 1
    if tick() - E.fpsHora >= 1 then
        E.fps, E.quadros, E.fpsHora, E.medido = math.max(E.quadros, 1), 0, tick(), true
    end
    if not (AccessGranted and CFG.esp) then
        if E.ligado then
            for _, d in pairs(E.alvos) do esconder(d) end
            E.ligado = false
        end
        return
    end
    E.ligado = true
    local intervalo = 1 / math.max(CFG.espTaxa, 1)
    if CFG.espDesempenho and E.medido and E.fps < CFG.espFpsMin then intervalo = intervalo * 2 end
    if tick() - E.ultimo < intervalo then return end
    E.ultimo = tick()

    local minhaPos = myPos()
    local fila = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local c = p.Character
            local r = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
            local h = c:FindFirstChildOfClass("Humanoid")
            if r then
                local dist = (r.Position - minhaPos).Magnitude
                if podeMostrar(p, h, dist) then
                    fila[#fila+1] = { p = p, c = c, r = r, h = h, dist = dist }
                end
            end
        end
    end
    table.sort(fila, function(a, b) return a.dist < b.dist end)
    local limite = CFG.espLimite
    if CFG.espDesempenho and E.medido and E.fps < CFG.espFpsMin then
        limite = math.max(3, math.floor(limite * 0.5))
    end
    local mostrados = {}
    for i, e in ipairs(fila) do
        if i > limite then break end
        mostrados[e.p] = true
        local d = E.alvos[e.p]
        if d and (not d.brilho or not d.brilho.Parent or d.raiz ~= e.r) then
            apagar(d) d = nil E.alvos[e.p] = nil
        end
        if not d then
            local ok, novoD = pcall(criarPecas, e.p, e.r)
            if ok and novoD then novoD.raiz = e.r d = novoD E.alvos[e.p] = d end
        end
        if d then
            local visivel = true
            if CFG.espChecarVisao or CFG.espModoCor == 5 then
                local okV, res = pcall(estaVisivel, e.r.Position, e.c)
                visivel = okV and res or true
            end
            if CFG.espSoVisivel and not visivel then
                esconder(d)
            else
                local vmax = (e.h and e.h.MaxHealth > 0) and e.h.MaxHealth or 100
                local okA, altura = pcall(alturaDoCorpo, e.c)
                local okP = pcall(pintarAlvo, e.p, d, {
                    nome = (CFG.espTipoNome == 0) and e.p.DisplayName
                           or (CFG.espTipoNome == 1) and e.p.Name
                           or (e.p.DisplayName .. " (@" .. e.p.Name .. ")"),
                    dist = e.dist, vida = e.h and e.h.Health or 0,
                    vidaFrac = e.h and (e.h.Health / vmax) or 1,
                    visivel = visivel, mesmoTime = mesmoTime(e.p),
                    altura = okA and altura or 6, deslocamento = d.deslocamento, raiz = e.r,
                })
                if not okP then esconder(d) end
            end
        end
    end
    for p, d in pairs(E.alvos) do
        if not mostrados[p] then
            esconder(d)
            if not p.Parent then apagar(d) E.alvos[p] = nil end
        end
    end
end)
Players.PlayerRemoving:Connect(function(p)
    local d = E.alvos[p]
    if d then apagar(d) E.alvos[p] = nil end
end)

