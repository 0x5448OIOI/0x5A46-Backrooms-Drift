local function scanRecolor(roots, oldCol, newCol, mode)
    if oldCol == newCol then return end
    for _, root in ipairs(roots) do
        if root then
            for _, o in ipairs(root:GetDescendants()) do
                if mode == "bg" then
                    pcall(function()
                        if o:IsA("GuiObject") and o.BackgroundColor3 == oldCol then o.BackgroundColor3 = newCol end
                    end)
                elseif mode == "text" then
                    pcall(function()
                        if (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox"))
                            and o.TextColor3 == oldCol then o.TextColor3 = newCol end
                    end)
                elseif mode == "stroke" then
                    pcall(function()
                        if o:IsA("UIStroke") and o.Color == oldCol then o.Color = newCol end
                    end)
                end
            end
        end
    end
end
setAccent = function(col)
    Theme.Accent = col
    local vivos = {}
    for _, e in ipairs(Reg.accent) do
        if e.obj and e.obj.Parent then
            vivos[#vivos+1] = e
            if (not e.only) or e.only() then pcall(function() e.obj[e.prop] = col end) end
        end
    end
    Reg.accent = vivos
    for _, tab in ipairs(Win.Tabs) do pcall(function() tab.Indicator.BackgroundColor3 = col end) end
    if RadarBorda then pcall(function() RadarBorda.Color = col end) end
    for _, fn in ipairs(Reg.refresh) do pcall(fn) end
end
setBgColor = function(col)
    local oldWin, oldSide, oldCard = Theme.Window, Theme.Sidebar, Theme.Card
    local oldField, oldHover, oldLine, oldStroke = Theme.Field, Theme.Hover, Theme.Line, Theme.Stroke
    Theme.Window   = col
    Theme.Sidebar  = Color3.new(col.R * 0.75, col.G * 0.75, col.B * 0.75)
    Theme.Card     = lighten(col, 0.06)
    Theme.Field    = lighten(col, 0.13)
    Theme.Hover    = lighten(col, 0.18)
    Theme.Line     = lighten(col, 0.16)
    Theme.Stroke   = lighten(col, 0.22)
    Theme.TrackOff = lighten(col, 0.20)
    local roots = { Win.Main }
    scanRecolor(roots, oldWin,    Theme.Window,  "bg")
    scanRecolor(roots, oldSide,   Theme.Sidebar, "bg")
    scanRecolor(roots, oldCard,   Theme.Card,    "bg")
    scanRecolor(roots, oldField,  Theme.Field,   "bg")
    scanRecolor(roots, oldHover,  Theme.Hover,   "bg")
    scanRecolor(roots, oldLine,   Theme.Line,    "bg")
    scanRecolor(roots, oldStroke, Theme.Stroke,  "stroke")
    scanRecolor(roots, oldLine,   Theme.Line,    "stroke")
end
