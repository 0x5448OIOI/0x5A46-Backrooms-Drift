local function acharStat(palavras)
    local function bate(nome)
        local n = string.lower(nome)
        for _, p in ipairs(palavras) do
            if string.find(n, p, 1, true) then return true end
        end
        return false
    end
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v:IsA("ValueBase") and bate(v.Name) then return v end
        end
    end
    for _, v in ipairs(LP:GetDescendants()) do
        if v:IsA("ValueBase") and bate(v.Name) then return v end
    end
    return nil
end
