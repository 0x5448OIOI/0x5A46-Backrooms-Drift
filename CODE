local Radar, RadarPontos, RadarConn, RadarBorda = nil, {}, nil, nil
local RadarCoinPontos = {}
local function tirarRadar()
    if RadarConn then RadarConn:Disconnect() RadarConn = nil end
    if Radar then pcall(function() Radar:Destroy() end) Radar = nil end
    RadarPontos, RadarCoinPontos = {}, {}
end
local function ligarRadar(on)
    tirarRadar()
    if not on then return end
    Radar = mk("Frame", {
        Name = "MN_Radar", Size = UDim2.new(0, CFG.radarTam, 0, CFG.radarTam),
        Position = UDim2.new(1, -CFG.radarTam - 20, 0, 70),
        BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 0.3,
        BorderSizePixel = 0, Active = true, Draggable = true,
    }, hudGui)
    mk("UICorner", { CornerRadius = UDim.new(1, 0) }, Radar)
    RadarBorda = mk("UIStroke", { Color = Theme.Accent, Thickness = 1.5, Transparency = 0.3 }, Radar)
    mk("Frame", {
        Size = UDim2.new(1,0,0,1), Position = UDim2.new(0,0,0.5,0),
        BackgroundColor3 = Color3.fromRGB(55,55,66), BorderSizePixel = 0,
    }, Radar)
    mk("Frame", {
        Size = UDim2.new(0,1,1,0), Position = UDim2.new(0.5,0,0,0),
        BackgroundColor3 = Color3.fromRGB(55,55,66), BorderSizePixel = 0,
    }, Radar)
    local eu = mk("Frame", {
        Size = UDim2.new(0,7,0,7), Position = UDim2.new(0.5,-3.5,0.5,-3.5),
        BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 4,
    }, Radar)
    mk("UICorner", { CornerRadius = UDim.new(1,0) }, eu)

    RadarConn = RunService.RenderStepped:Connect(function()
        if not (CFG.radar and Radar and Radar.Parent) then return end
        Radar.Size = UDim2.new(0, CFG.radarTam, 0, CFG.radarTam)
        local r = myRoot()
        if not r then return end
        local meio = CFG.radarTam * 0.5
        local esc  = meio / CFG.radarAlcance
        local co, si = 1, 0
        if CFG.radarGira then
            local cam = Camera.CFrame.LookVector
            local ang = math.atan2(cam.X, cam.Z)
            co, si = math.cos(-ang), math.sin(-ang)
        end
        local function plotar(delta)
            local dx, dz = delta.X, delta.Z
            if CFG.radarGira then dx, dz = dx * co - dz * si, dx * si + dz * co end
            return UDim2.new(0, meio + dx * esc - 3.5, 0, meio + dz * esc - 3.5)
        end
        ------------------------------------------------ jogadores
        local vistos = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local pr = p.Character:FindFirstChild("HumanoidRootPart")
                local h  = p.Character:FindFirstChildOfClass("Humanoid")
                if pr then
                    local delta = pr.Position - r.Position
                    if delta.Magnitude <= CFG.radarAlcance then
                        vistos[p] = true
                        local pt = RadarPontos[p]
                        if not pt or not pt.Parent then
                            pt = mk("Frame", { Size = UDim2.new(0,7,0,7), BorderSizePixel = 0, ZIndex = 3 }, Radar)
                            mk("UICorner", { CornerRadius = UDim.new(1,0) }, pt)
                            RadarPontos[p] = pt
                        end
                        pt.Position = plotar(delta)
                        local vmax = (h and h.MaxHealth > 0) and h.MaxHealth or 100
                        pt.BackgroundColor3 = corDoAlvo({
                            dist = delta.Magnitude, vidaFrac = h and (h.Health / vmax) or 1,
                            mesmoTime = mesmoTime(p), visivel = true, deslocamento = 0,
                        })
                    end
                end
            end
        end
        for p, pt in pairs(RadarPontos) do
            if not vistos[p] then pcall(function() pt:Destroy() end) RadarPontos[p] = nil end
        end
        ------------------------------------------------ coins
        local vistosC = {}
        if CFG.radarCoins then
            local cor = corCoin()
            for _, coin in ipairs(listaCoins()) do
                local pos = posDoCoin(coin)
                if pos then
                    local delta = pos - r.Position
                    if delta.Magnitude <= CFG.radarAlcance then
                        vistosC[coin] = true
                        local pt = RadarCoinPontos[coin]
                        if not pt or not pt.Parent then
                            pt = mk("Frame", { Size = UDim2.new(0,4,0,4), BorderSizePixel = 0, ZIndex = 2 }, Radar)
                            mk("UICorner", { CornerRadius = UDim.new(1,0) }, pt)
                            RadarCoinPontos[coin] = pt
                        end
                        local p2 = plotar(delta)
                        pt.Position = UDim2.new(0, p2.X.Offset + 1.5, 0, p2.Y.Offset + 1.5)
                        pt.BackgroundColor3 = cor
                    end
                end
            end
        end
        for coin, pt in pairs(RadarCoinPontos) do
            if not vistosC[coin] then pcall(function() pt:Destroy() end) RadarCoinPontos[coin] = nil end
        end
    end)
end

