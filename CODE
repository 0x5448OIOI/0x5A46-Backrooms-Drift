local NOMES_CHASSIS = { "Chassis", "Base", "DriveSeat", "VehicleSeat", "Seat", "Body", "Main" }
local function definirPrimaryPart(car)
    if car.PrimaryPart and car.PrimaryPart.Parent then return car.PrimaryPart end
    for _, nome in ipairs(NOMES_CHASSIS) do
        local p = car:FindFirstChild(nome, true)
        if p and p:IsA("BasePart") then car.PrimaryPart = p return p end
    end
    car.PrimaryPart = car:FindFirstChildWhichIsA("BasePart", true)
    return car.PrimaryPart
end
local function getPlayerCar()
    local pasta = workspace:FindFirstChild("Cars")
    if not pasta then return nil, "sem workspace.Cars" end
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    -- 1) sentado nele
    if hum then
        for _, c in ipairs(pasta:GetChildren()) do
            if c:IsA("Model") then
                for _, s in ipairs(c:GetDescendants()) do
                    if (s:IsA("Seat") or s:IsA("VehicleSeat")) and s.Occupant == hum then
                        return c, "assento"
                    end
                end
            end
        end
    end
    -- 2) atributo com meu id/nome
    for _, c in ipairs(pasta:GetChildren()) do
        if c:IsA("Model") then
            for _, v in pairs(c:GetAttributes()) do
                if tostring(v) == tostring(LP.UserId) or tostring(v) == LP.Name then
                    return c, "atributo"
                end
            end
        end
    end
    -- 3) mais proximo de mim
    if hrp then
        local melhor, melhorD = nil, 150
        for _, c in ipairs(pasta:GetChildren()) do
            if c:IsA("Model") then
                local p = definirPrimaryPart(c)
                if p then
                    local dd = (p.Position - hrp.Position).Magnitude
                    if dd < melhorD then melhor, melhorD = c, dd end
                end
            end
        end
        if melhor then return melhor, ("proximidade %.0f"):format(melhorD) end
    end
    return nil, "nenhum"
end
local function posAlvoMagnet()
    if CFG.magnetCarro then
        local car = getPlayerCar()
        if car then
            local p = definirPrimaryPart(car)
            if p then return p.Position, "carro" end
        end
    end
    local hrp = myRoot()
    if hrp then return hrp.Position, "personagem" end
    return nil, "nada"
end

------------------------------------------------------------ AUTO DRIFT
local teclasPresas = {}
local function tecla(down, kc)
    if not VIM then return end
    pcall(function() VIM:SendKeyEvent(down, kc, false, game) end)
end
local function segurar(kc)
    if teclasPresas[kc] then return end
    teclasPresas[kc] = true
    tecla(true, kc)
end
local function soltar(kc)
    if not teclasPresas[kc] then return end
    teclasPresas[kc] = nil
    tecla(false, kc)
end
local function soltarTudo()
    for kc in pairs(teclasPresas) do teclasPresas[kc] = nil tecla(false, kc) end
end
local function getStopCar()
    local net  = RS:FindFirstChild("Network")
    local bind = net and net:FindFirstChild("Bindable")
    local cars = bind and bind:FindFirstChild("Cars")
    return cars and cars:FindFirstChild("StopCar")
end

local driftConn, driftT = nil, 0
local function ligarDrift()
    if driftConn then return end
    if not VIM then
        F.driftInfo = "executor sem VirtualInputManager"
        return
    end
    local stopCar = getStopCar()
    driftConn = RunService.Heartbeat:Connect(function(dt)
        if not CFG.driftOn then return end
        driftT += dt
        segurar(Enum.KeyCode.W)
        if CFG.driftLado == 0 then
            soltar(Enum.KeyCode.D) segurar(Enum.KeyCode.A)
        else
            soltar(Enum.KeyCode.A) segurar(Enum.KeyCode.D)
        end
        if CFG.driftFreio then
            if CFG.driftPulsar then
                local ciclo = math.max(CFG.driftPulso, 0.05) * 2
                local ligado = (driftT % ciclo) < (ciclo * 0.5)
                if ligado then
                    segurar(Enum.KeyCode.LeftControl)
                    if stopCar then pcall(function() stopCar:Fire(true) end) end
                else
                    soltar(Enum.KeyCode.LeftControl)
                    if stopCar then pcall(function() stopCar:Fire(false) end) end
                end
            else
                segurar(Enum.KeyCode.LeftControl)
                if stopCar then pcall(function() stopCar:Fire(true) end) end
            end
        else
            soltar(Enum.KeyCode.LeftControl)
            if stopCar then pcall(function() stopCar:Fire(false) end) end
        end
        F.driftInfo = ("rodando · %s%s"):format(
            CFG.driftLado == 0 and "esquerda" or "direita",
            CFG.driftFreio and (CFG.driftPulsar and " · pulsando" or " · freio preso") or "")
    end)
end
local function desligarDrift()
    if driftConn then driftConn:Disconnect() driftConn = nil end
    soltarTudo()
    local stopCar = getStopCar()
    if stopCar then pcall(function() stopCar:Fire(false) end) end
    F.driftInfo = "parado"
end

