local C = {}
C.marcas = {}          -- [coin] = pecas
C.ultimo = 0
C.perto  = nil         -- coin mais proximo
C.total  = 0

local function corCoin()
    return Color3.fromRGB(CFG.espCoinCorR, CFG.espCoinCorG, CFG.espCoinCorB)
end

local function criarMarcaCoin(coin)
    local m = {}
    local ancora = coin
    if coin:IsA("Model") then
        ancora = coin.PrimaryPart or coin:FindFirstChildWhichIsA("BasePart", true) or coin
    end
    m.ancora = ancora
    m.brilho = mk("Highlight", {
        Name = "MN_CoinBrilho", Adornee = coin, FillTransparency = 0.5,
        OutlineTransparency = 0.1, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false,
    }, espHolder)
    m.placa = mk("BillboardGui", {
        Name = "MN_CoinPlaca", Adornee = ancora, Size = UDim2.new(0, 170, 0, 34),
        StudsOffset = Vector3.new(0, 2.2, 0), AlwaysOnTop = true,
        MaxDistance = math.huge, LightInfluence = 0, Enabled = false,
    }, espHolder)
    m.txtNome = mk("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        TextSize = 12, TextStrokeTransparency = 0.2, TextColor3 = Color3.new(1,1,1),
    }, m.placa)
    m.txtDist = mk("TextLabel", {
        Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 17),
        BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 11,
        TextStrokeTransparency = 0.35, TextColor3 = Color3.new(1,1,1),
    }, m.placa)
    m.tracer = nil
    return m
end
local function apagarMarcaCoin(m)
    if m.brilho then pcall(function() m.brilho:Destroy() end) end
    if m.placa  then pcall(function() m.placa:Destroy() end) end
    if m.tracer then pcall(function() m.tracer:Destroy() end) end
end
local function esconderMarcaCoin(m)
    if m.brilho then m.brilho.Enabled = false end
    if m.placa  then m.placa.Enabled = false end
    if m.tracer then m.tracer.Visible = false end
end
function C.limpar()
    for coin, m in pairs(C.marcas) do apagarMarcaCoin(m) C.marcas[coin] = nil end
    C.perto = nil
end

RunService.Heartbeat:Connect(function()
    if not (AccessGranted and CFG.espCoin) then
        if next(C.marcas) then
            for _, m in pairs(C.marcas) do esconderMarcaCoin(m) end
        end
        C.perto = nil
        return
    end
    if tick() - C.ultimo < 0.1 then return end
    C.ultimo = tick()

    local minhaPos = myPos()
    local cor = corCoin()
    local coins = listaCoins()
    C.total = #coins

    local fila = {}
    for _, coin in ipairs(coins) do
        local pos = posDoCoin(coin)
        if pos then
            local dist = (pos - minhaPos).Magnitude
            if CFG.espCoinDist <= 0 or dist <= CFG.espCoinDist then
                fila[#fila+1] = { coin = coin, pos = pos, dist = dist }
            end
        end
    end
    table.sort(fila, function(a, b) return a.dist < b.dist end)
    C.perto = fila[1]

    local vistos = {}
    for i, e in ipairs(fila) do
        if i > CFG.espCoinLimite then break end
        vistos[e.coin] = true
        local m = C.marcas[e.coin]
        if m and (not m.placa or not m.placa.Parent) then
            apagarMarcaCoin(m) m = nil C.marcas[e.coin] = nil
        end
        if not m then
            local ok, novo = pcall(criarMarcaCoin, e.coin)
            if ok and novo then m = novo C.marcas[e.coin] = m end
        end
        if m then
            if CFG.espCoinBrilho then
                m.brilho.Adornee = e.coin
                m.brilho.FillColor = cor
                m.brilho.OutlineColor = cor
                m.brilho.FillTransparency = CFG.espCoinTransp
                m.brilho.Enabled = true
            else
                m.brilho.Enabled = false
            end
            if CFG.espCoinNome or CFG.espCoinDistancia then
                m.placa.Enabled = true
                m.txtNome.Visible = CFG.espCoinNome
                m.txtNome.Text = e.coin.Name
                m.txtNome.TextColor3 = cor
                m.txtNome.TextSize = CFG.espCoinFonte
                m.txtDist.Visible = CFG.espCoinDistancia
                m.txtDist.Text = math.floor(e.dist) .. "m"
                m.txtDist.TextColor3 = cor
                m.txtDist.TextSize = math.max(CFG.espCoinFonte - 1, 8)
            else
                m.placa.Enabled = false
            end
        end
    end
    for coin, m in pairs(C.marcas) do
        if not vistos[coin] then
            esconderMarcaCoin(m)
            if not coin.Parent then apagarMarcaCoin(m) C.marcas[coin] = nil end
        end
    end
end)

-- tracer / seta dos coins (por frame)
local setaCoin = nil
RunService.RenderStepped:Connect(function()
    if not (AccessGranted and CFG.espCoin) then
        if setaCoin then setaCoin.Visible = false end
        for _, m in pairs(C.marcas) do if m.tracer then m.tracer.Visible = false end end
        return
    end
    local vp = Camera.ViewportSize
    local cor = corCoin()
    if CFG.espCoinTracer then
        local origem = Vector2.new(vp.X * 0.5, vp.Y)
        for coin, m in pairs(C.marcas) do
            if m.placa and m.placa.Enabled and coin.Parent then
                if not m.tracer then m.tracer = makeLine() end
                local pos = posDoCoin(coin)
                local fim = pos and projetar(pos, vp)
                if fim then
                    m.tracer.Visible = setLine(m.tracer, origem, fim, 1, cor, 0.45)
                else
                    m.tracer.Visible = false
                end
            elseif m.tracer then
                m.tracer.Visible = false
            end
        end
    else
        for _, m in pairs(C.marcas) do if m.tracer then m.tracer.Visible = false end end
    end
    -- seta apontando o coin mais proximo
    if CFG.espCoinSeta and C.perto and C.perto.coin and C.perto.coin.Parent then
        if not setaCoin then
            setaCoin = mk("TextLabel", {
                AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(40, 40),
                BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "▲",
                TextSize = 26, TextStrokeTransparency = 0.4, Visible = false,
            }, hudGui)
        end
        local pos = posDoCoin(C.perto.coin)
        if pos then
            local centro = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
            local ok, sp = pcall(function() return Camera:WorldToViewportPoint(pos) end)
            local dir
            if ok and sp and sp.Z > 0 then
                dir = Vector2.new(sp.X, sp.Y) - centro
            else
                local rel = Camera.CFrame:PointToObjectSpace(pos)
                dir = Vector2.new(-rel.X, rel.Z)
            end
            if dir.Magnitude > 1 then
                local u = dir.Unit
                setaCoin.Position = UDim2.fromOffset(centro.X + u.X * 120, centro.Y + u.Y * 120)
                setaCoin.Rotation = math.deg(math.atan2(u.Y, u.X)) + 90
                setaCoin.TextColor3 = cor
                setaCoin.Visible = true
            end
        end
    elseif setaCoin then
        setaCoin.Visible = false
    end
end)

