local function httpFetch(url)
    local tries = {
        function() return game:HttpGet(url) end,
        function() return game:HttpGetAsync(url) end,
        function()
            local req = (syn and syn.request) or (http and http.request) or http_request or request
            if req then
                local r = req({ Url = url, Method = "GET" })
                return r and (r.Body or r.body)
            end
        end,
    }
    for _, fn in ipairs(tries) do
        local ok, res = pcall(fn)
        if ok and type(res) == "string" and #res > 0 then return res end
    end
    return nil
end
local function looksDirectImage(u)
    u = string.lower(u)
    return (string.find(u, "%.png") or string.find(u, "%.jpe?g") or string.find(u, "%.webp")) ~= nil
end
local function extractImageFromHtml(html)
    if type(html) ~= "string" then return nil end
    local pin = string.match(html, 'https://i%.pinimg%.com/[%w%p]-%.jpg')
             or string.match(html, 'https://i%.pinimg%.com/[%w%p]-%.png')
    if pin then return pin end
    local og = string.match(html, 'og:image"%s*content="([^"]+)"')
            or string.match(html, 'content="([^"]+)"%s*property="og:image"')
    if og then return (string.gsub(og, "&amp;", "&")) end
    return string.match(html, 'https://[%w%p]-%.jpg') or string.match(html, 'https://[%w%p]-%.png')
end
setBgImage = function(input)
    input = string.gsub(string.gsub(tostring(input or ""), "^%s+", ""), "%s+$", "")
    CFG.BgImage = input
    local function setStat(t) if statusImg then statusImg.set(t) end end
    if input == "" then
        Win.BgImage.Image = ""
        Win.BgImage.Visible = false
        setStat("Vazio.")
        return
    end
    if tonumber(input) then
        Win.BgImage.Image = "rbxassetid://" .. input
        Win.BgImage.ImageTransparency = CFG.BgTransparency
        Win.BgImage.Visible = true
        setStat("Carregando ID " .. input .. "...")
        task.delay(1.2, function()
            if Win.BgImage.Visible and not Win.BgImage.IsLoaded then
                Win.BgImage.Image = "rbxthumb://type=Asset&id=" .. input .. "&w=420&h=420"
                setStat("Aplicado via thumb (ID " .. input .. ")")
            else
                setStat("Imagem aplicada (ID " .. input .. ")")
            end
        end)
        if Win.SyncMini then pcall(function() Win:SyncMini() end) end
        if requestSave then requestSave() end
        notify("Fundo", "imagem aplicada", 3)
        return
    end
    local content
    if string.sub(input, 1, 13) == "rbxassetid://" then
        content = input
    elseif string.sub(input, 1, 4) == "http" then
        if not (writefile and getcustomasset) then
            setStat("Executor sem writefile/getcustomasset. Use um ID do Roblox.")
            return
        end
        local imgUrl = input
        if not looksDirectImage(imgUrl) then
            setStat("Procurando a imagem na pagina...")
            local page = httpFetch(imgUrl)
            local found = page and extractImageFromHtml(page)
            if found then imgUrl = found
            else setStat("Nao achei a imagem na pagina. Use o link direto (.jpg/.png).") return end
        end
        setStat("Baixando imagem...")
        local data = httpFetch(imgUrl)
        if not data then setStat("Falha ao baixar. Tente um ID do Roblox.") return end
        local ext = string.find(string.lower(imgUrl), "%.jpe?g") and "jpg" or "png"
        local fname = "midnight_bg." .. ext
        local ok = pcall(function()
            writefile(fname, data)
            content = getcustomasset(fname)
        end)
        if not ok or not content then setStat("Falha ao salvar a imagem.") return end
    else
        if not getcustomasset then setStat("Executor sem getcustomasset.") return end
        local ok = pcall(function() content = getcustomasset(input) end)
        if not ok or not content then setStat("Arquivo nao achado no executor.") return end
    end
    if content then
        Win.BgImage.Image = content
        Win.BgImage.ImageTransparency = CFG.BgTransparency
        Win.BgImage.Visible = true
        setStat("Imagem aplicada!")
        if Win.SyncMini then pcall(function() Win:SyncMini() end) end
        if requestSave then requestSave() end
        notify("Fundo", "imagem aplicada", 3)
    else
        setStat("Nao foi possivel aplicar.")
    end
end

