function Window:Select(tab)
    for _, other in ipairs(self.Tabs) do
        local on = other == tab
        other.Page.Visible = on
        tween(other.Button,    { BackgroundTransparency = on and 0.45 or 1 })
        tween(other.Label,     { TextColor3 = on and Theme.Text or Theme.SubText })
        tween(other.Icon,      { TextColor3 = on and Theme.Text or Theme.SubText })
        tween(other.Indicator, { Size = UDim2.fromOffset(3, on and 20 or 0) }, SMOOTH)
    end
    self.Active = tab
    self:_filter(self.Search.Text)
end

