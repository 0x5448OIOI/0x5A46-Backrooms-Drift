local LIMITE_TELA = 4
local function projetar(pos, vp)
    local ok, sp = pcall(function() return Camera:WorldToViewportPoint(pos) end)
    if not ok or not sp then return nil end
    if sp.Z <= 1 then return nil end
    if math.abs(sp.X) > vp.X * LIMITE_TELA or math.abs(sp.Y) > vp.Y * LIMITE_TELA then return nil end
    return Vector2.new(sp.X, sp.Y)
end
local function makeLine()
    return mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0, Visible = false,
    }, hudGui)
end
local function setLine(f, a, b, th, col, transp)
    local dx, dy = b.X - a.X, b.Y - a.Y
    local len = math.sqrt(dx * dx + dy * dy)
    f.Size = UDim2.fromOffset(len, th or 2)
    f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
    if len > 6000 or len ~= len then f.Visible = false return false end
    f.Rotation = math.deg(math.atan2(dy, dx))
    f.BackgroundColor3 = col
    f.BackgroundTransparency = transp or 0
    return true
end

